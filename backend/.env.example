# =============================================================================
# Hakinga Backend - Environment Variables
# =============================================================================
# Copy this file to .env and update the values for your environment
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection URL (required)
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hakinga

# Connection pool settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Secret key for JWT token signing (CHANGE IN PRODUCTION!)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<generate-with-python-c-import-secrets-print-secrets-token-urlsafe-64>

# JWT algorithm
ALGORITHM=HS256

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password reset token expiration
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Debug mode (set to false in production)
DEBUG=true

# Application name
APP_NAME=Hakinga API

# API prefix
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Allowed origins for CORS (JSON array format)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# -----------------------------------------------------------------------------
# Redis Configuration (Optional)
# -----------------------------------------------------------------------------
# Redis URL for caching and session storage
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Email Configuration (Optional - required for password reset)
# -----------------------------------------------------------------------------
# SMTP server host
EMAIL_HOST=smtp.gmail.com

# SMTP authentication
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# SMTP port (587 for TLS, 465 for SSL)
EMAIL_PORT=587

# Sender name/email
EMAIL_FROM=noreply@hakinga.com
