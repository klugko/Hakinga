#!/usr/bin/env bash
set -euo pipefail

readonly COMMIT_MSG_FILE="$1"
readonly COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly NC='\033[0m'

readonly PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?: .{1,72}$"

validate_commit_message() {
    local first_line
    first_line=$(echo "$COMMIT_MSG" | head -n1)

    if [[ ${#first_line} -gt 72 ]]; then
        echo -e "${RED}[ERROR]${NC} Commit message first line exceeds 72 characters"
        return 1
    fi

    if ! echo "$first_line" | grep -qE "$PATTERN"; then
        echo -e "${RED}[ERROR]${NC} Commit message does not follow conventional format"
        echo ""
        echo "Expected format: <type>(<scope>): <description>"
        echo ""
        echo "Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
        echo ""
        echo "Examples:"
        echo "  feat(auth): add password reset endpoint"
        echo "  fix(frontend): resolve navigation bug"
        echo "  docs: update API documentation"
        echo ""
        return 1
    fi

    echo -e "${GREEN}[OK]${NC} Commit message format valid"
    return 0
}

if [[ "$COMMIT_MSG" == Merge* ]] || [[ "$COMMIT_MSG" == Revert* ]]; then
    exit 0
fi

validate_commit_message
