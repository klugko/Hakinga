#!/usr/bin/env bash
set -euo pipefail

readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m'

readonly MAX_FILE_SIZE_KB=500
readonly BACKEND_DIR="backend"
readonly FRONTEND_DIR="frontend"

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

get_staged_files() {
    git diff --cached --name-only --diff-filter=ACM
}

get_staged_files_in_dir() {
    local dir="$1"
    local extension="$2"
    get_staged_files | grep "^${dir}/.*\.${extension}$" || true
}

check_file_size() {
    log_info "Checking file sizes..."
    local has_large_files=false

    while IFS= read -r file; do
        if [[ -f "$file" ]]; then
            local size_kb
            size_kb=$(du -k "$file" | cut -f1)
            if [[ "$size_kb" -gt "$MAX_FILE_SIZE_KB" ]]; then
                log_error "File '$file' is ${size_kb}KB (max: ${MAX_FILE_SIZE_KB}KB)"
                has_large_files=true
            fi
        fi
    done < <(get_staged_files)

    if [[ "$has_large_files" == "true" ]]; then
        return 1
    fi
    return 0
}

check_forbidden_patterns() {
    log_info "Checking for forbidden patterns..."
    local has_forbidden=false
    local patterns=(
        "console\.log\s*\("
        "debugger"
        "TODO.*FIXME"
        "password\s*=\s*['\"][^'\"]+['\"]"
        "api[_-]?key\s*=\s*['\"][^'\"]+['\"]"
        "secret\s*=\s*['\"][^'\"]+['\"]"
    )

    while IFS= read -r file; do
        if [[ -f "$file" ]] && [[ "$file" != *.md ]] && [[ "$file" != *.txt ]]; then
            for pattern in "${patterns[@]}"; do
                if grep -qE "$pattern" "$file" 2>/dev/null; then
                    local match
                    match=$(grep -nE "$pattern" "$file" | head -1)
                    log_warn "Suspicious pattern in '$file': $match"
                fi
            done
        fi
    done < <(get_staged_files)

    return 0
}

check_trailing_whitespace() {
    log_info "Checking for trailing whitespace..."
    local has_trailing=false

    while IFS= read -r file; do
        if [[ -f "$file" ]] && [[ "$file" != *.md ]]; then
            if grep -qE '\s+$' "$file" 2>/dev/null; then
                log_warn "Trailing whitespace in '$file'"
            fi
        fi
    done < <(get_staged_files)

    return 0
}

run_backend_checks() {
    local py_files
    py_files=$(get_staged_files_in_dir "$BACKEND_DIR" "py")

    if [[ -z "$py_files" ]]; then
        log_info "No Python files staged, skipping backend checks"
        return 0
    fi

    log_info "Running backend checks..."

    if ! command -v ruff &> /dev/null; then
        log_warn "ruff not found, skipping Python linting"
    else
        log_info "Running ruff..."
        if ! ruff check $BACKEND_DIR --fix --exit-non-zero-on-fix; then
            log_error "ruff check failed"
            return 1
        fi
    fi

    return 0
}

run_frontend_checks() {
    local ts_files tsx_files js_files
    ts_files=$(get_staged_files_in_dir "$FRONTEND_DIR" "ts")
    tsx_files=$(get_staged_files_in_dir "$FRONTEND_DIR" "tsx")
    js_files=$(get_staged_files_in_dir "$FRONTEND_DIR" "js")

    if [[ -z "$ts_files" ]] && [[ -z "$tsx_files" ]] && [[ -z "$js_files" ]]; then
        log_info "No TypeScript/JavaScript files staged, skipping frontend checks"
        return 0
    fi

    log_info "Running frontend checks..."

    if [[ ! -d "$FRONTEND_DIR/node_modules" ]]; then
        log_warn "node_modules not found, skipping frontend linting"
        return 0
    fi

    log_info "Running ESLint..."
    if ! (cd "$FRONTEND_DIR" && npx eslint . 2>/dev/null); then
        log_error "ESLint check failed"
        return 1
    fi

    return 0
}

main() {
    echo ""
    echo "========================================"
    echo "         Pre-commit Hook"
    echo "========================================"
    echo ""

    local exit_code=0

    check_file_size || exit_code=1
    check_forbidden_patterns || exit_code=1
    check_trailing_whitespace || exit_code=1
    run_backend_checks || exit_code=1
    run_frontend_checks || exit_code=1

    echo ""
    if [[ "$exit_code" -eq 0 ]]; then
        log_info "All checks passed"
    else
        log_error "Some checks failed. Fix issues before committing."
        echo ""
        echo "To bypass this hook (not recommended), use: git commit --no-verify"
    fi
    echo ""

    exit $exit_code
}

main "$@"
