# =============================================================================
# Hakinga - Environment Variables
# =============================================================================
# Copy this file to .env and update the values for your environment
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
#
# IMPORTANT: Choose ONE configuration based on how you run the application:
#
# -----------------------------------------------------------------------------
# OPTION 1: Local Development (without Docker)
# -----------------------------------------------------------------------------
# Use DATABASE_URL to connect to your local PostgreSQL instance.
# Uncomment and configure this line:
#
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost/hakinga
#
# Example with default PostgreSQL credentials:
# DATABASE_URL=postgresql+asyncpg://postgres:abcd@localhost/hakinga
#
# -----------------------------------------------------------------------------
# OPTION 2: Docker Compose
# -----------------------------------------------------------------------------
# When using Docker Compose, the DATABASE_URL is automatically constructed
# from these variables in docker-compose.yml. Do NOT set DATABASE_URL here.
# Just configure these values:
#
POSTGRES_USER=hakinga
POSTGRES_PASSWORD=<your-secure-password-here>
POSTGRES_DB=hakinga
POSTGRES_PORT=5432

# Note: On local dev, use 5433 to avoid conflicts with local PostgreSQL
# The backend inside Docker connects via 'db:5432' (internal network)

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------
# Secret key for JWT (CHANGE IN PRODUCTION!)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<generate-with-python-c-import-secrets-print-secrets-token-urlsafe-64>

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database pool
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# CORS origins (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost"]

# Debug mode
DEBUG=false

# Application
APP_NAME=Hakinga API
API_V1_PREFIX=/api/v1

# Run migrations on startup (Docker only)
RUN_MIGRATIONS=true

# Email configuration (optional)
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_FROM=noreply@hakinga.com

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1

# -----------------------------------------------------------------------------
# Ports (Docker Compose)
# -----------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=80

# -----------------------------------------------------------------------------
# Production Settings
# -----------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
